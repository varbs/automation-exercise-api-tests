    {
      "name": "02 Search",
      "item": [
        {
          "name": "API 5: Search a product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\nconst term = \"top\";\n\n// The match may be in the name or category, so this only checks that something matches\nconst text = JSON.stringify(body.products).toLowerCase();\n\npm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is 200\", () => {\n    pm.expect(body.responseCode).to.eql(200);\n});\n\npm.test(\"Search returns at least one product\", () => {\n    pm.expect(body.products).to.be.an(\"array\").that.is.not.empty;\n});\n\npm.test(\"Results relate to the search term\", () => {\n    pm.expect(text).to.include(term);\n});\n\npm.test(\"Every results relates to the search term\", () => {\n    body.products.forEach(p => {\n        pm.expect(text).to.include(term);\n    });\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "search_product",
                "value": "top"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "search_product",
                  "value": "top"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/searchProduct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "searchProduct"
              ]
            }
          },
          "response": []
        },
